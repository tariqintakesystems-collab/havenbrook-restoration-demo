# Havenbrook Restoration demo — required environment variables
# Set these in the Vercel project dashboard (Settings -> Environment Variables).
# Never commit real values to source control.

# Anthropic API key used by api/chat.js to call the Claude Messages API.
ANTHROPIC_API_KEY=

# Vercel Blob read/write token used by api/upload.js (via @vercel/blob's put())
# to store visitor-uploaded photos. Standard Vercel Blob SDK variable name —
# generated automatically once a Blob store is created and connected to this
# project (Storage tab -> Create Database -> Blob), or can be set manually.
BLOB_READ_WRITE_TOKEN=
